# cyan 环境配置模板
# 用法：cp .env.example .env，然后按需修改

# ── Core Daemon ───────────────────────────────────────────────
CYAN_HOST=127.0.0.1
CYAN_PORT=7437

# ── Logging ───────────────────────────────────────────────────
CYAN_LOG_LEVEL=INFO
# 留空则仅输出 stderr，不写文件
CYAN_LOG_FILE=~/.cyan/logs/core.log
# text（人工可读键值对）或 json（结构化，适合日志聚合）
CYAN_LOG_FORMAT=text

# ── Config File ───────────────────────────────────────────────
# CYAN_CONFIG=~/.cyan/config.toml

# ── Incident Agent LLM ───────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
CYAN_LLM_DEFAULT_MODEL=deepseek-v4-flash
CYAN_MAX_STEPS=20
